# Copy to .env.local for local dev and replace the placeholders.
# In Vercel, set the same names under Project → Settings → Environment Variables.
# All values are server-only. Never prefix any of these with NEXT_PUBLIC_.

# xAI (Grok) via the openai npm package
XAI_API_KEY=your-xai-api-key
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1

# Supabase (server routes only; the browser never talks to Supabase)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
